{
    "python-envs.defaultEnvManager": "ms-python.python:system",

    "[python]": {
        "editor.indentSize": 4,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
    },

    "[flutter]": {
        "editor.indentSize": 2,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
    },

    "dart.lineLength": 80,
    "dart.previewFlutterUiGuides": true,
    "dart.openDevTools": "flutter",

    "files.exclude": {
        "**/.venv": true,
        "**/__pycache__": true
    },

    "search.exclude": {
        "**/.venv": true,
        "**/__pycache__": true,
        "**/build": true
    },

    "[dart]": {
        "editor.lineHighlight": "none",
        "editor.selectionHighlight": false
    }
}